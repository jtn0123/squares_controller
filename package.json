{
  "name": "squares-controller",
  "version": "0.12.0",
  "private": false,
  "description": "Local-first browser controller for Twinkly Squares",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtn0123/squares_controller.git"
  },
  "type": "module",
  "scripts": {
    "start": "npm run build && python3 server.py",
    "build": "tsc -p tsconfig.json && node scripts/build_html.mjs",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && python3 -m unittest discover -s test -p 'test_*.py' && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
